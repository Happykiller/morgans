### sendMailWithTemplate FitDesk Invite From Coach To Existing Athlete
POST http://localhost:8025/graphql
Content-Type: application/json

{
  "query": "mutation sendMailWithTemplate($input: MailTemplateInput!) { sendMailWithTemplate(input: $input) { success message } }",
  "variables": {
    "input": {
      "to": "thomas.things@gmail.com",
      "subject": "Thomas Martin t'invite a le rejoindre sur FitDesk",
      "template": "fitdeskinvitefromcoachtoexistingathlete.fr.html",
      "variables": {
        "firstName": "Thomas",
        "coachName": "Thomas Martin",
        "invitationUrl": "https://app.fitdesk.io/invitations/respond/secure-token"
      }
    }
  }
}

